{
  "name": "test-car-shop",
  "version": "1.0.0",
  "description": "Portfolio API and UI automation framework for car-shop-demo.",
  "type": "module",
  "scripts": {
    "test": "npm run test:api && npm run test:ui",
    "test:api": "mocha \"tests/api/**/*.spec.js\" --timeout 15000 --reporter allure-mocha",
    "test:api:watch": "mocha \"tests/api/**/*.spec.js\" --timeout 15000 --watch",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "report:allure": "allure generate allure-results --clean --output allure-report",
    "report:allure:open": "allure open allure-report"
  },
  "keywords": [
    "api-testing",
    "playwright",
    "mocha",
    "allure",
    "github-actions",
    "terraform",
    "car-shop-demo"
  ],
  "author": "Oleksandr Kryvorotko",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "allure-commandline": "^2.43.0",
    "allure-mocha": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "mocha": "^12.0.2"
  }
}
